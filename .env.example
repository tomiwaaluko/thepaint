# Database — Supabase direct connection (use for migrations and Railway services)
DATABASE_URL=postgresql+asyncpg://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Redis — Upstash or Railway Redis add-on (set REDIS_URL from the add-on dashboard)
REDIS_URL=redis://localhost:6379/0

# Odds API — get key from the-odds-api.com
ODDS_API_KEY=your_key_here

# Gemini API - required for AI injury ingestion
# GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash

# MLflow — set to Railway MLflow service URL in production, or localhost for local dev
MLFLOW_TRACKING_URI=http://localhost:5000

# Logging
LOG_LEVEL=INFO

# nba_api disk cache (local only; Railway services use ephemeral storage)
NBA_API_CACHE_DIR=.cache/nba_api

# MLB StatsAPI (statsapi.mlb.com) — keyless, no API key needed
MLB_API_CACHE_DIR=.cache/mlb_api
MLB_API_TIMEOUT=30
MLB_API_MAX_RETRIES=5

# Slack alerts (optional — leave blank to disable)
SLACK_WEBHOOK_URL=

# GitHub Personal Access Token — required for the CodeRabbit MCP server (.mcp.json).
# Create a fine-grained or classic PAT at https://github.com/settings/tokens:
#   - Public repos only: `public_repo` scope is sufficient
#   - Private repos: use `repo` scope (grants full read/write — least-privilege alternative
#     is a fine-grained PAT scoped to the specific repository with Contents: read)
# Keep this secret — never commit the actual token value.
GITHUB_PAT=your_github_pat_here

# CORS — comma-separated list of allowed origins for the FastAPI backend.
# Set to your Railway frontend URL in production, e.g.:
# ALLOWED_ORIGINS=https://chalk-frontend.up.railway.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Per-client rate limiting (counters stored in Redis; fails open if Redis is down)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_PREDICT_PER_MINUTE=30

# Token required for DELETE /v1/games/{id}/cache and the nocache query param.
# Leave blank to disable cache invalidation endpoints entirely.
CACHE_INVALIDATION_TOKEN=

# Number of proxies in front of this service that append to X-Forwarded-For.
# The rate limiter reads the client address as the Nth entry from the right;
# entries to its left are caller-supplied and must not be trusted.
# Railway's edge is one hop. Set to 0 when nothing is in front.
TRUSTED_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Local Airflow stack (docker compose --profile airflow up)
# ---------------------------------------------------------------------------
# Airflow is local-development only; production uses Railway cron.
# These are REQUIRED because docker-compose interpolates the whole file, and
# they intentionally have no defaults - the previous Fernet default looked like
# it generated a key per deployment but was a fixed literal string, which made
# Airflow's connection encryption worthless.
#
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
#   openssl rand -hex 32
AIRFLOW_SECRET_KEY=
#   openssl rand -base64 24
AIRFLOW_ADMIN_PASSWORD=
